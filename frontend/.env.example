VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_COLYSEUS_URL=wss://your-backend.onrender.com
VITE_WHITEBOARD_BASE_URL=https://your-whiteboard-domain.com
VITE_PEER_HOST=your-peer-service.onrender.com
VITE_PEER_PORT=443
VITE_PEER_PATH=/peerjs
VITE_PEER_SECURE=true
# Cloudflare STUN URLs (comma-separated or JSON array)
VITE_STUN_URL=stun:stun.cloudflare.com:3478
# Cloudflare TURN URLs (comma-separated or JSON array). Port 53 URLs are filtered in browser.
VITE_TURN_URL=turn:turn.cloudflare.com:3478?transport=udp,turn:turn.cloudflare.com:3478?transport=tcp,turn:turn.cloudflare.com:80?transport=tcp,turns:turn.cloudflare.com:5349?transport=tcp,turns:turn.cloudflare.com:443?transport=tcp
# Optional fallback only (backend /rtc/ice now provides short-lived credentials)
VITE_TURN_USERNAME=your_generated_turn_username
VITE_TURN_CREDENTIAL=your_generated_turn_credential